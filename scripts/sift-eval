#!/usr/bin/env bash
# Measures ranking quality on Java 21: runs eval/queries.json against data/articles.jsonl and writes
# eval/results/<label>.txt and eval/results/<label>.tsv.
# Usage (from anywhere):  scripts/sift-eval <label> [--config NAME=SPEC ...]
#   e.g.  scripts/sift-eval baseline-bm25
#         scripts/sift-eval grid --config base=bm25 --config s2=bm25sum:w=2,bb=0.3 --config s2a=bm25sum:w=2,bb=0.3,wa=1
# Another query file:  SIFT_QUERIES=eval/queries-holdout.json scripts/sift-eval <label> ...
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
LABEL="${1:?usage: scripts/sift-eval <label> [--config NAME=SPEC ...]}"
shift

"$ROOT/gradlew" -p "$ROOT" -q :engine:installDist
JAVA_HOME="$("$ROOT/gradlew" -p "$ROOT" -q :engine:printJavaHome | tail -n 1)"

# The commit the numbers belong to; "-dirty" if tracked files have uncommitted changes.
COMMIT="$(git -C "$ROOT" rev-parse --short HEAD)"
git -C "$ROOT" diff --quiet HEAD || COMMIT="$COMMIT-dirty"
MACHINE="$(sysctl -n machdep.cpu.brand_string 2>/dev/null || uname -m), $(getconf _NPROCESSORS_ONLN) cores"

cd "$ROOT"
exec "$JAVA_HOME/bin/java" -Xmx4g -cp "engine/build/install/sift-cli/lib/*" dev.sift.engine.eval.EvalCli \
    data/articles.jsonl "${SIFT_QUERIES:-eval/queries.json}" --label "$LABEL" --commit "$COMMIT" --machine "$MACHINE" \
    --redirects data/redirects.jsonl "$@"
