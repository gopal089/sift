#!/usr/bin/env bash
# Builds ALL the data the server needs, once, into data/ (git-ignored). Each step is skipped if its output
# already exists, so it is safe to re-run. Needs: Python 3.11+, Java 21 (Gradle fetches it), ~4 GB free disk.
# Time on an Apple M5: ~2 min parse, ~15 s index, ~17 min embeddings (GPU; much longer on CPU), ~4 min graph.
#
#   scripts/sift-data
#
# Steps: Python venv → download the pinned dump → parse → index → export bge-small to ONNX → embed every
# article (title + first 60 words) → HNSW graph + int8 vectors.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"
DUMP_DATE="${SIFT_DUMP_DATE:-20261101}"   # pinned; Wikimedia keeps dumps for a few months, then use a newer date
DUMP="data/dump/simplewiki-$DUMP_DATE-pages-articles.xml.bz2"
DUMP_SHA1_20261101="0b040b8e4e6e58de4bfbafee6050bd6bbf991f19"
PY=data-prep/.venv/bin/python
step() { printf '\n== %s\n' "$1"; }

step "1/7 Python environment (data-prep/.venv)"
if [[ ! -x "$PY" ]]; then
  python3 -m venv data-prep/.venv
  "$PY" -m pip install -q -r data-prep/requirements.txt
else echo "exists"; fi

step "2/7 Download $DUMP"
if [[ ! -f "$DUMP" ]]; then
  mkdir -p data/dump
  curl -fL --retry 3 -A "sift-data-script (portfolio search engine)" -o "$DUMP.part" \
    "https://dumps.wikimedia.org/simplewiki/$DUMP_DATE/$(basename "$DUMP")"
  if [[ "$DUMP_DATE" == 20261101 ]]; then
    echo "$DUMP_SHA1_20261101  $DUMP.part" | shasum -a 1 -c -
  fi
  mv "$DUMP.part" "$DUMP"
else echo "exists"; fi

step "3/7 Parse the dump → data/articles.jsonl, data/redirects.jsonl"
if [[ ! -f data/articles.jsonl ]]; then "$PY" -I data-prep/parse_dump.py "$DUMP" data; else echo "exists"; fi

step "4/7 Build the index → data/index"
if [[ ! -f data/index/meta.json ]]; then scripts/sift-index; else echo "exists"; fi

step "5/7 Export bge-small-en-v1.5 to ONNX → data/model-bge"
if [[ ! -f data/model-bge/model.onnx ]]; then
  "$PY" -I data-prep/export_model.py --model BAAI/bge-small-en-v1.5 --out data/model-bge \
    --query-prefix "Represent this sentence for searching relevant passages: "
else echo "exists"; fi

step "6/7 Embed every article (title + first 60 words) → data/vectors-bge60"
if [[ ! -f data/vectors-bge60/vectors-f32.bin ]]; then
  "$PY" -I data-prep/embed_articles.py data/articles.jsonl --model BAAI/bge-small-en-v1.5 --words 60 \
    --out data/vectors-bge60
else echo "exists"; fi

step "7/7 HNSW graph (M 16, efConstruction 200) + int8 vectors"
if [[ ! -f data/vectors-bge60/hnsw.bin ]]; then
  SIFT_XMX=3g scripts/sift-run vector.HnswBuildCli data/index data/vectors-bge60 --m 16 --efc 200
else echo "exists"; fi

printf '\nDone. Start the server with scripts/sift-api, or build the container: docker build -t sift .\n'
